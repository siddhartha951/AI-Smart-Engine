# ==============================================================================
# Environment Configuration - AI Smart Engine (Shopify AI Shopping Assistant)
# NOTE: This file contains template variable names ONLY. Never commit real secrets or values.
# ==============================================================================

# Server / Runtime
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_smart_engine

# AI Provider Configuration (OpenAI or Mock)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET_WARN_USD=10.00
AI_MONTHLY_BUDGET_STOP_USD=14.00

# Shopify Integration (Adapter Mode: fake | real)
SHOPIFY_ADAPTER_MODE=real
SHOPIFY_API_VERSION=2024-01
SHOPIFY_CLIENT_SECRET=

# Email Service (Provider Mode: fake | resend)
EMAIL_PROVIDER_MODE=resend
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
EMAIL_FROM_NAME=Shopping Assistant

# Security & Tokens (32+ char random strings)
SESSION_SECRET=
UNSUBSCRIBE_SIGNING_SECRET=
ENCRYPTION_KEY=
