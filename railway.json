{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 100
  },
  "services": {
    "web": {
      "deploy": {
        "startCommand": "npm run start"
      }
    },
    "worker": {
      "deploy": {
        "startCommand": "npm run worker"
      }
    }
  }
}
